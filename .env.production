# ─────────────────────────────────────────────────────────────────────────
# socket-hub — PRODUCTION environment (Hostinger, no Redis)
# Upload this to the server as ".env" in the application root.
# Keep it SECRET — never commit it to git.
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=production
LOG_LEVEL=info

# Browser/app origins allowed to connect. Comma-separated, no spaces, with https://.
# EDIT THESE to your real frontend/admin domains. (Mobile-only clients can ignore CORS,
# but set known web origins anyway.)
CORS_ORIGINS=https://cupet.semantik-code.com,https://accounting.semantik-code.com,https://deacons.semantik-code.com

# Do NOT set PORT  -> the platform/Passenger assigns it.
# Do NOT set REDIS_URL -> unset = single-process in-memory mode (correct for this plan).

# Projects -> Socket.IO namespaces (/cupet, /accounting, /deacons)
PROJECTS=cupet,accounting,deacons

# ─── Per-project secrets ────────────────────────────────────────────────────
# *_JWT_SECRET     : signs the JWTs your clients connect with.
# *_TRIGGER_SECRET : signs the HMAC on backend POST /api/trigger calls.
# The SAME values must be configured in each matching Laravel app.

CUPET_JWT_SECRET=a67da1d17b2303dbddf3dd4eddb362267706ad45aa21654629b97cd5bdcc46e1
CUPET_TRIGGER_SECRET=776ec5da454030e1a1d89eb93898f794cf5d06f2a4a31f4cc95b15ddff150e68

ACCOUNTING_JWT_SECRET=6eba89f09b382d1b31fde7524343d4d82e2ad8737f33b54fe6841a4d4cd52c2c
ACCOUNTING_TRIGGER_SECRET=300fbbfd9b490a42482ab8e89aaa1544b68c4c9cfe2346993fa471dda4eeeea2

DEACONS_JWT_SECRET=340f0fbf637b361b6337d7ce4e5b5c8ffe6ca1c62d335b8ca667fe1142b1e6bd
DEACONS_TRIGGER_SECRET=a6f31f7e37469befea835a4874f8cc582e9402134216bbc9b6792a80b4384e97
