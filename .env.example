# ─── Server ───────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# Comma-separated list of allowed CORS origins for the Socket.IO handshake.
# Use "*" only for local development.
CORS_ORIGINS=*

# ─── Redis (OPTIONAL) ───────────────────────────────────────────────────────
# Leave UNSET to run single-process (in-memory) mode — no Redis required.
# This is the mode for Hostinger Node hosting (publish via the HTTP trigger API).
# Set it to enable horizontal scaling (Socket.IO adapter) AND the Redis publish
# bridge (path B). Same server, dedicated node, or managed service — only this
# value changes.
# REDIS_URL=redis://localhost:6379

# ─── Projects ───────────────────────────────────────────────────────────────
# Comma-separated list of project names. Each becomes a Socket.IO namespace
# (/cupet, /accounting, ...). For every NAME you must define:
#   <NAME>_JWT_SECRET      -> verifies client connection JWTs
#   <NAME>_TRIGGER_SECRET  -> verifies backend HMAC signatures on /api/trigger
# (NAME is uppercased; dashes become underscores.)
PROJECTS=cupet,accounting,deacons

CUPET_JWT_SECRET=change-me-cupet-jwt
CUPET_TRIGGER_SECRET=change-me-cupet-trigger

ACCOUNTING_JWT_SECRET=change-me-accounting-jwt
ACCOUNTING_TRIGGER_SECRET=change-me-accounting-trigger

DEACONS_JWT_SECRET=change-me-deacons-jwt
DEACONS_TRIGGER_SECRET=change-me-deacons-trigger
